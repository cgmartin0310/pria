{
  "name": "@pria/backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "seed:payers": "tsx src/db/seed-payers.ts",
    "seed:clearinghouses": "tsx src/db/seed-clearinghouses.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@clerk/backend": "^1.21.0",
    "@pria/shared": "workspace:*",
    "bullmq": "^5.14.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/sensible": "^6.0.2",
    "ioredis": "^5.4.2",
    "pg": "^8.13.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
